# Backend environment variables override optional YAML configuration.
# Go does not automatically load this file. Export these variables in your shell.
MEDIA_HUB_HTTP_ADDR=127.0.0.1:8080
MEDIA_HUB_DATABASE_PATH=./data/115-media-hub.db
MEDIA_HUB_LOG_DIR=./logs
MEDIA_HUB_SHUTDOWN_TIMEOUT=10s

# Optional environment variable when launching the Vite proxy:
# MEDIA_HUB_DEV_API_URL=http://127.0.0.1:8080

# Required by Docker Compose. Remove the leading # and replace both values.
# MEDIA_HUB_ADMIN_USERNAME=your-admin-name
# MEDIA_HUB_ADMIN_PASSWORD=replace-with-a-long-random-password
# Enable for HTTPS deployments; keep false for local HTTP loopback.
# MEDIA_HUB_COOKIE_SECURE=false

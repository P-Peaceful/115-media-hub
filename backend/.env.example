# 本地开发示例；Docker 镜像会将数据库、日志等路径配置到容器内的 /app/ 下。
MEDIAHUB_HTTP_ADDR=:8080
MEDIAHUB_DATABASE_PATH=./data/mediahub.db
MEDIAHUB_LOG_LEVEL=INFO
# 可选，启用 10 MiB × 4 文件、最多保留 7 天的日志轮转。
MEDIAHUB_LOG_FILE=
MEDIAHUB_SHUTDOWN_TIMEOUT=10s

# HTTPS 反向代理部署必须设为 true；默认 false 便于同源 HTTP 本地开发。
# 不根据 X-Forwarded-* 自动推断安全属性。
MEDIAHUB_COOKIE_SECURE=false
